{
  "manifest_version": 3,
  "name": "GitUp – Pro tools for GitHub",
  "short_name": "GitUp",
  "version": "1.0.0",
  "description": "Copy PR base/head branches in one click, see branches on PR lists, and branch/tag chips in GitHub Actions.",
  "homepage_url": "https://github.com/nawinkhatiwada/GitUp",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://github.com/*"
      ],
      "js": [
        "src/utils.js",
        "src/branches.js",
        "src/features/pr-branches.js",
        "src/features/pr-list-branches.js",
        "src/features/actions-branches.js",
        "src/main.js"
      ],
      "css": [
        "src/styles.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
